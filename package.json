{
  "name": "serverest-cypress-tests",
  "version": "1.0.0",
  "description": "Testes automatizados E2E (frontend) e de API da aplicação ServeRest com Cypress",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:e2e": "cypress run --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:smoke": "cypress run --expose grepTags=@smoke,grepFilterSpecs=true,grepOmitFiltered=true",
    "test:contract": "cypress run --expose grepTags=@contract,grepFilterSpecs=true,grepOmitFiltered=true",
    "data:cleanup": "node scripts/limpar-massa.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cypress/grep": "^7.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
